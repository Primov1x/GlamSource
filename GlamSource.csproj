<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <TargetPlatformIdentifier>windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>7.0</TargetPlatformVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Name>GlamSource</Name>
    <Author>TF</Author>
    <Punchline>Zeigt woher Glams und Mounts kommen.</Punchline>
    <Description>Hover ueber ein Item oder Mount und sieh sofort die Quelle.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Version>0.0.0.165</Version>
    <AssemblyVersion>0.0.0.165</AssemblyVersion>
    <IconUrl>https://raw.githubusercontent.com/Primov1x/GlamSource/main/images/icon.png</IconUrl>
    <InternalsVisibleTo>GlamSource.Mock</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)GlamSource.Core\GlamSource.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Glamourer.Api" Version="2.8.2">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- ponytail: version MUST match Dalamud's own Newtonsoft.Json exactly (13.0.4, see
         reference/Dalamud/Directory.Packages.props) and must NOT be copied to our output —
         Dalamud already loads its own copy, and any mismatched/duplicate copy makes our JObject
         a different runtime type than Glamourer's, breaking cross-plugin IPC with a silent
         "blew up when converting from ValueTuple`2..." cast failure (confirmed via trace). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
    <PackageReference Include="Lumina.Excel" Version="7.4.3" />
    <!-- ponytail: same D3D11 interop bindings Dalamud itself uses (see Dx11Renderer.cs) — for the
         web-UI 3D preview's GPU texture readback. Version matches what this Dalamud build ships. -->
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.5" />
    <!-- GDI+ JPEG encode for the web-UI MJPEG preview stream (PreviewRenderer.EncodeJpeg) — a
         Windows-only native wrapper, which matches this project's net10.0-windows7.0 TFM exactly. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Glamourer.Api">
      <HintPath>$(NuGetPackageRoot)glamourer.api\2.8.2\lib\net10.0-windows7.0\Glamourer.Api.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="reference\**" />
    <Compile Remove="GlamSource.Core.Tests\**" />
    <Compile Remove="GlamSource.Core\**" />
    <Compile Remove="GlamSource.Mock\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\goat.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="glmsrc_13477456200560497766.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="GlamSource.Core.Tests\fixtures\target-example.json">
      <Link>fixtures\target-example.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
