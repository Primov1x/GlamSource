
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (lokal)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-no-key-required"
      },
      "models": {
        "qwen36-local": {
          "name": "Qwen3.6 lokal",
          "limit": { "context": 81920, "output": 16384 }
        }
      }
    },

    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Gateway",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "sk-96d513596f7aa4df-458835-9119e704"
      },
      "models": {
        "cloud-planner": {
          "name": "Free-Cloud Combo (Planung/Review)",
          "limit": { "context": 200000, "output": 32768 }
        }
      }
    }
  },

  "mcp": {
  
  },

  "default_agent": "build",

  "agent": {
    "build": {
      "description": "Umsetzung am Code. Laeuft lokal, sieht echte Daten.",
      "mode": "primary",
      "model": "local/qwen36-local",
      "temperature": 0.6,
  "permission": {
    "bash": {
      "*": "ask",
      "dotnet *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny",
      "ls*": "allow",
      "dir*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "type *": "allow"
    },
    "edit": "ask",
    "webfetch": "allow"
  }
},
    "plan": {
      "description": "Architektur, Planung, Review. Cloud - NIE mit echten Daten.",
      "mode": "primary",
      "model": "omniroute/cloud-planner",
      "temperature": 0.3,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
